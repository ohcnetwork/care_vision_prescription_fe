{
  "name": "care_vision_prescription_fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vision prescription structured question for CARE",
  "portless": {
    "name": "care-vision-prescription-fe",
    "script": "dev"
  },
  "scripts": {
    "dev": "vite",
    "start": "concurrently -n 'build,serve' -c 'green.bold,blue.bold' \"npm run build:watch\" \"npm run preview\"",
    "build:watch": "vite build --watch",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "format": "prettier --write src scripts public/locale/en.json '*.{json,mts,js}' .prettierrc",
    "format:check": "prettier --check src scripts public/locale/en.json '*.{json,mts,js}' .prettierrc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:single-react": "node scripts/check-single-react.mjs",
    "test:styles": "node scripts/check-styles.mjs",
    "guard": "npm run test:single-react && npm run test:styles",
    "guard:single-react": "npm run test:single-react",
    "guard:styles": "npm run test:styles",
    "sort-locales": "node --import tsx scripts/sort-locales.ts"
  },
  "author": "Open Healthcare Network",
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-i18next": "^6.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.1.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
